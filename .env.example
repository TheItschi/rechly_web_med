# Public app metadata
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Appwrite browser configuration
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://your-appwrite-instance/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=your-appwrite-project-id

# Appwrite server configuration
APPWRITE_API_ENDPOINT=https://your-appwrite-instance/v1
APPWRITE_PROJECT_ID=your-appwrite-project-id
APPWRITE_API_KEY=your-server-api-key

# Maintenance
CLEANUP_API_SECRET=replace-with-a-random-secret

# AI settings encryption
AI_SETTINGS_ENCRYPTION_SECRET=replace-with-a-long-random-secret
AI_DAILY_REQUEST_LIMIT=100
# Rechly-Med: own legal pages of the operator (needed when running for others).
# Registration shows the consent checkbox only if TERMS and PRIVACY are set.
NEXT_PUBLIC_IMPRINT_URL=
NEXT_PUBLIC_PRIVACY_URL=
NEXT_PUBLIC_TERMS_URL=
# Source link for AGPL § 13 (defaults to the GitHub fork)
NEXT_PUBLIC_SOURCE_URL=
