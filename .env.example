# Public app metadata
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_REPOSITORY_URL=https://github.com/your-org/rechly
NEXT_PUBLIC_CONTACT_EMAIL=contact@example.com
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_TWITTER_HANDLE=
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Appwrite browser configuration
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://your-appwrite-instance/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=your-appwrite-project-id

# Appwrite server configuration
APPWRITE_API_ENDPOINT=https://your-appwrite-instance/v1
APPWRITE_PROJECT_ID=your-appwrite-project-id
APPWRITE_API_KEY=your-server-api-key

# Maintenance
CLEANUP_API_SECRET=replace-with-a-random-secret

# Local-install updates (laptop clones only; banner only appears on localhost)
# RECHLY_UPDATE_CHECK=0 disables the GitHub update check.
# RECHLY_ALLOW_IN_APP_UPDATE=0 disables the dashboard "Update now" button (npm run update still works).
# RECHLY_UPDATE_REPO=owner/repo overrides the repo checked (default: NEXT_PUBLIC_REPOSITORY_URL).
# RECHLY_UPDATE_GITHUB_TOKEN= optional; raises the GitHub API rate limit for update checks.

# AI settings encryption
AI_SETTINGS_ENCRYPTION_SECRET=replace-with-a-long-random-secret
AI_DAILY_REQUEST_LIMIT=100

# Optional server-side AI fallbacks for receipt OCR (users can also bring their own key)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434/v1
# Hosted instances block user-configured AI endpoints on private/loopback
# addresses (SSRF protection). Self-hosters running Ollama on localhost/LAN
# next to the web app can opt in:
# RECHLY_ALLOW_LOCAL_AI_ENDPOINTS=1

# Optional workspace. Run scripts/migrate-workspace.mjs before enabling and rebuild.
NEXT_PUBLIC_RECHLY_WORKSPACE_ENABLED=0
