# Self-hosted Appwrite + Next.js environment template (Coolify / Docker / self-hosted)
# Set these in your hosting environment variables. Never commit secrets.

NEXT_PUBLIC_APPWRITE_ENDPOINT=https://appwrite.example.com/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=replace-with-appwrite-project-id

APPWRITE_API_ENDPOINT=https://appwrite.example.com/v1
APPWRITE_PROJECT_ID=replace-with-appwrite-project-id
# Server API key created in your self-hosted Appwrite Console.
APPWRITE_API_KEY=replace-with-self-hosted-server-key

# Unchanged values (keep from existing environment):
# NEXT_PUBLIC_APP_URL=https://your-domain.example.com
# CLEANUP_API_SECRET=...
# AI_SETTINGS_ENCRYPTION_SECRET=...
# AI_DAILY_REQUEST_LIMIT=100
# NEXT_PUBLIC_RECHLY_WORKSPACE_ENABLED=1
# Enable only after scripts/migrate-workspace.mjs and a staging transaction check.
# Includes projects, tasks, documents, time billing, reports and calendar.

# NOTE: NEXT_PUBLIC_* values are inlined at build time — a full redeploy is
# required after changing them (trigger a full rebuild without cache).
